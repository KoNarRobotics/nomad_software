<?xml version="1.0" ?>
<robot name="nomad_t_model"
  xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="silver">
    <color rgba="0.700 0.700 0.700 1.000"/>
  </material>

  <material name="black">
    <color rgba="0.100 0.100 0.100 1.000"/>
  </material>

  <material name="dark_grey">
    <color rgba="0.250 0.250 0.250 1.000"/>
  </material>

  <material name="green">
    <color rgba="0.000 0.800 0.000 1.000"/>
  </material>

  <material name="blue">
    <color rgba="0.000 0.000 0.800 1.000"/>
  </material>

</robot>

    <origin rpy="0 0 0" xyz="0.55 0.2 0.25"/>
  </joint>
  <!-- FRONT-->
  <joint name="camera_front_joint" type="fixed">
    <!-- <origin xyz="0.55 0.2 0.25" rpy="0 0 0"/> -->
    <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
    <parent link="camera_360_mount"/>
    <child link="camera_front_link"/>
  </joint>
  <link name="camera_front_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/lemonx/it/nomad_software/install/camera_360/share/camera_360/meshes/xyz.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="camera_front_optical_joint" type="fixed">
    <parent link="camera_front_link"/>
    <child link="camera_front_link_optical"/>
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0.0 0.0 0.0"/>
  </joint>
  <link name="camera_front_link_optical"/>
  <!-- LEFT-->
  <joint name="camera_left_joint" type="fixed">
    <origin rpy="0 0 1.5707963267948966" xyz="0.0 0.0 0.0"/>
    <parent link="camera_360_mount"/>
    <child link="camera_left_link"/>
  </joint>
  <link name="camera_left_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/lemonx/it/nomad_software/install/camera_360/share/camera_360/meshes/xyz.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="camera_left_optical_joint" type="fixed">
    <parent link="camera_left_link"/>
    <child link="camera_left_link_optical"/>
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0.0 0.0 0.0"/>
  </joint>
  <link name="camera_left_link_optical"/>
  <!-- RIGHT-->
  <joint name="camera_right_joint" type="fixed">
    <origin rpy="0 0 -1.5707963267948966" xyz="0.0 0.0 0.0"/>
    <parent link="camera_360_mount"/>
    <child link="camera_right_link"/>
  </joint>
  <link name="camera_right_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/lemonx/it/nomad_software/install/camera_360/share/camera_360/meshes/xyz.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="camera_right_optical_joint" type="fixed">
    <parent link="camera_right_link"/>
    <child link="camera_right_link_optical"/>
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0.0 0.0 0.0"/>
  </joint>
  <link name="camera_right_link_optical"/>
  <link name="lidar_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/lemonx/it/nomad_software/install/camera_360/share/camera_360/meshes/xyz.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>
  <link name="livox_frame">
    <!-- <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/> -->
    <!-- <geometry>
          <mesh filename="file://$(find camera_360)/meshes/xyz.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="red"></material>
      </visual> -->
  </link>
  <joint name="lidar_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.0 0.0 0.08"/>
    <parent link="camera_360_mount"/>
    <child link="lidar_link"/>
  </joint>
  <joint name="lidar_link" type="fixed">
    <origin rpy="0 0.174532925 0" xyz="0.0 0.0 0.0"/>
    <parent link="camera_360_mount"/>
    <child link="livox_frame"/>
  </joint>
  <link name="base_laser"/>
  <joint name="laser_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
    <parent link="lidar_link"/>
    <child link="base_laser"/>
  </joint>
  <!-- Camera 360 mount end -->
  <!-- LIVOX mount -->
  <!-- LIVOX mount end -->
  <ros2_control name="VescSystem" type="system">
    <!-- <hardware>
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        <param name="can_interface">can0</param>
      </hardware> -->
    <hardware>
      <plugin>vesc_hardware/MCVescHardware</plugin>
      <param name="can_interface">can0</param>
      <param name="command_interface_type">velocity</param>
      <param name="gear_ratio">4.375</param>
      <param name="polar_pairs">7</param>
      <param name="current_to_torque">0.0665</param>
      <!-- / 66.5 mNm/A is the torque constant for the VESC motor -->
      <!-- <parameter>$(find nomad_bringup)/config/nomad_controllers.yaml</parameter> -->
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-40</param>
        <param name="max">40</param>
      </command_interface>
      <command_interface name="current">
        <param name="min">-60</param>
        <param name="max">60</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-7</param>
        <param name="max">7</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="current"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-40</param>
        <param name="max">40</param>
      </command_interface>
      <command_interface name="current">
        <param name="min">-60</param>
        <param name="max">60</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-7</param>
        <param name="max">7</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="current"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="left_wheel_joint_2">
      <command_interface name="velocity">
        <param name="min">-40</param>
        <param name="max">40</param>
      </command_interface>
      <command_interface name="current">
        <param name="min">-60</param>
        <param name="max">60</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-7</param>
        <param name="max">7</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="current"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="right_wheel_joint_2">
      <command_interface name="velocity">
        <param name="min">-40</param>
        <param name="max">40</param>
      </command_interface>
      <command_interface name="current">
        <param name="min">-60</param>
        <param name="max">60</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-7</param>
        <param name="max">7</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="current"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
  <!-- <gazebo>
      <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so"/>
      <parameter>$(find nomad_bringup)/config/nomad_controllers.yaml</parameter>
    </gazebo> -->
  <!-- <xacro:unless value="${use_sim}"> -->
  <ros2_control name="BarometerSensor" type="sensor">
    <hardware>
      <plugin>barometer_hardware/MCBarometerHardware</plugin>
      <param name="can_interface">can0</param>
      <!-- <parameter>$(find nomad_bringup)/config/nomad_controllers.yaml</parameter> -->
    </hardware>
    <sensor name="barometer">
      <state_interface name="temperature"/>
      <state_interface name="pressure"/>
    </sensor>
  </ros2_control>
  <!-- </xacro:unless> -->
  <ros2_control name="nomad_imu" type="sensor">
    <hardware>
      <plugin>imu_hardware/MCImuHardware</plugin>
      <param name="can_interface">can0</param>
    </hardware>
    <sensor name="imu">
      <state_interface name="orientation.x"/>
      <state_interface name="orientation.y"/>
      <state_interface name="orientation.z"/>
      <state_interface name="orientation.w"/>
      <state_interface name="linear_acceleration.x"/>
      <state_interface name="linear_acceleration.y"/>
      <state_interface name="linear_acceleration.z"/>
      <state_interface name="magnetic_field.x"/>
      <state_interface name="magnetic_field.y"/>
      <state_interface name="magnetic_field.z"/>
      <state_interface name="angular_velocity.x"/>
      <state_interface name="angular_velocity.y"/>
      <state_interface name="angular_velocity.z"/>
      <state_interface name="temperature"/>
    </sensor>
  </ros2_control>
  <!-- <xacro:unless value="${use_sim}"> -->
  <ros2_control name="nomad_gps" type="sensor">
    <hardware>
      <plugin>gps_hardware/MCGpsHardware</plugin>
      <param name="can_interface">can0</param>
    </hardware>
    <sensor name="gps">
      <state_interface name="status"/>
      <state_interface name="service"/>
      <state_interface name="latitude"/>
      <state_interface name="longitude"/>
      <state_interface name="altitude"/>
      <state_interface name="latitude_covariance"/>
      <state_interface name="longitude_covariance"/>
      <state_interface name="altitude_covariance"/>
      <state_interface name="year"/>
      <state_interface name="month"/>
      <state_interface name="day"/>
      <state_interface name="hour"/>
      <state_interface name="minute"/>
      <state_interface name="second"/>
    </sensor>
  </ros2_control>
  <!-- </xacro:unless> -->
  <!-- <xacro:ros_control_geiger name="nomad" /> -->
  <!-- <xacro:ros_control_barometer name="nomad" use_sim="${use_sim}" /> -->
</robot>

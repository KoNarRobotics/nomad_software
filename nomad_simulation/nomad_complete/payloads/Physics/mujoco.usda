"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "nomad_robot"
{
    over "Physics"
    {
        def MjcActuator "revolute_arm_6_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </nomad_robot/Physics/revolute_arm_6>
        }

        def MjcActuator "revolute_arm_5_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </nomad_robot/Physics/revolute_arm_5>
        }


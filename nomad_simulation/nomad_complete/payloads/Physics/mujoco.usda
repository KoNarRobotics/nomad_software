            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </nomad_robot/Physics/revolute_arm_2>
        }

        def MjcActuator "revolute_arm_1_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </nomad_robot/Physics/revolute_arm_1>
        }

        def MjcActuator "left_wheel_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </nomad_robot/Physics/left_wheel_joint>
        }

        def MjcActuator "left_wheel_joint_2_actuator"

# filepath: /etc/systemd/system/nomad.service
[Unit]
Description=Nomad base diff drive robt control
After=can_control.service
Requires=can_control.service

[Service]
Type=simple
User=ubuntu
ExecStart=/home/ubuntu/it/nomad_software/services/start_base.sh
Restart=on-failure

[Install]
WantedBy=multi-user.target
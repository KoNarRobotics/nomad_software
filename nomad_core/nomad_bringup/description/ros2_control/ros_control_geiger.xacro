<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="ros_control_geiger" params="name">

    <!-- <xacro:unless value="${use_sim}"> -->

    <ros2_control name="${name}_geiger" type="sensor">

      <hardware>
        <plugin>geiger_hardware/MCGeigerHardware</plugin>
        <param name="can_interface">can0</param>
      </hardware>

      <sensor name="geiger">
        <state_interface name="siwert"/>
        <state_interface name="cpm"/>
      </sensor>

    </ros2_control>

    <!-- </xacro:unless> -->

  </xacro:macro>

</robot>

<?xml version="1.0"?>
<!-- NOMAD -->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="nomad_robot">
  <xacro:arg name="nomad" default="" />



  <!-- Import Nomad ros2_control descriptions -->

  <xacro:include filename="$(find nomad_bringup)/ros2_control/ros_control_vesc.xacro" />

  <xacro:include filename="$(find nomad_bringup)/ros2_control/ros_control_barometer.xacro" />

  <xacro:include filename="$(find nomad_bringup)/ros2_control/ros_control_imu.xacro" />


  <xacro:include filename="$(find nomad_bringup)/ros2_control/ros_control_gps.xacro" />

  <!-- <xacro:include filename="$(find nomad_bringup)/ros2_control/ros_control_geiger.xacro" /> -->

  <!-- Import Nomad ros2_control descriptions end -->



  <!-- Used for fixing robot -->
  <!-- <link name="map"/> -->
  <!-- <link name="odom"/> -->
  <link name="base_link"/>
  <link name="base_reasonable_link"/>

  <joint name="base_reasonable_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_reasonable_link"/>
    <origin xyz="-0.345 -0.2 0" rpy="0 0 0"/>
  </joint>


  <!-- Nomad T model description -->

  <!-- Import Nomad urdf model description -->
  <xacro:include filename="$(find nomad_t_model_description)/urdf/nomad_t_model.xacro" />

  <xacro:nomad_t_model parent="base_reasonable_link"></xacro:nomad_t_model>

  <!-- Nomad T model description end -->


  <!-- Camera 360 mount -->
  <xacro:include filename="$(find camera_360)/urdf/camera_360.xacro" />

  <link name="camera_360_mount"/>

  <joint name="camera_360_joint" type="fixed">
    <parent link="base_reasonable_link"/>
    <child link="camera_360_mount"/>
    <origin xyz="0.55 0.2 0.25" rpy="0 0 0"/>
  </joint>

  <xacro:camera_360 parent="camera_360_mount">
  </xacro:camera_360>

  <!-- Camera 360 mount end -->


  <!-- LIVOX mount -->


  <!-- LIVOX mount end -->






  <xacro:vesc_ros2_control name="nomad" />


  <xacro:ros_control_barometer name="nomad" />

  <xacro:ros_control_imu name="nomad" />

  <xacro:ros_control_gps name="nomad"/>

  <!-- <xacro:ros_control_geiger name="nomad" /> -->

  <!-- <xacro:ros_control_barometer name="nomad" use_sim="${use_sim}" /> -->




</robot>

<?xml version="1.0"?>
<!-- Revolute-Revolute Manipulator -->
<!--
Copied and modified from ROS1 example -
https://github.com/ros-simulation/gazebo_ros_demos/blob/kinetic-devel/rrbot_description/urdf/rrbot.xacro
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="2dof_robot">
  <xacro:arg name="nomad" default="" />

  <!-- Import Nomad vesc ros ros2_control description -->
  <!-- <xacro:include filename="$(find vesc_hardware)/ros2_control/ros_control_vesc.xacro" /> -->

  <xacro:include filename="$(find nomad_bringup)/ros2_control/ros_control_vesc.xacro" />

  <xacro:include filename="$(find nomad_bringup)/ros2_control/ros_control_barometer.xacro" />


  <!-- Import Rviz colors  PROBALY NOT NEEDED since nomad_t_model have ewerthing -->
  <!-- <xacro:include filename="$(find nomad_t_model_description)/nomad_t_model_description/urdf/materials.xacro" /> -->

  <!-- Import Nomad urdf model description -->
  <xacro:include filename="$(find nomad_t_model_description)/urdf/nomad_t_model.xacro" />

  <!-- Used for fixing robot -->
  <link name="world"/>


  <xacro:nomad_t_model parent="world">
    <!-- <origin xyz="0 0 0" rpy="0 0 0" /> -->
  </xacro:nomad_t_model>

  <xacro:vesc_ros2_control name="nomad" />


  <xacro:ros_control_barometer name="nomad" />

  <!-- <xacro:ros_control_barometer name="nomad" use_sim="${use_sim}" /> -->




</robot>

<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="nomad_robot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import nomad_robot urdf file -->
    <xacro:include filename="$(find nomad_bringup)/description/urdf/nomad.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="nomad_robot.ros2_control.xacro" />


    <xacro:nomad_robot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
